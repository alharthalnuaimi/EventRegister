{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/display", "destination": "/frontend/display.html" },
    { "source": "/display/", "destination": "/frontend/display.html" },
    { "source": "/admin", "destination": "/frontend/admin.html" },
    { "source": "/admin/", "destination": "/frontend/admin.html" },
    { "source": "/dashboard", "destination": "/frontend/admin.html" },
    { "source": "/dashboard/", "destination": "/frontend/admin.html" },
    { "source": "/panel", "destination": "/frontend/admin.html" },
    { "source": "/panel/", "destination": "/frontend/admin.html" },
    { "source": "/admin/style.css", "destination": "/frontend/style.css" },
    { "source": "/admin/logo.jpg", "destination": "/frontend/logo.jpg" },
    { "source": "/admin/app.js", "destination": "/frontend/app.js" },
    { "source": "/display/style.css", "destination": "/frontend/style.css" },
    { "source": "/display/logo.jpg", "destination": "/frontend/logo.jpg" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}

